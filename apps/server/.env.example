# Copier en .env pour le développement local (pnpm dev),
# avec les services de docker-compose.dev.yml.
DATABASE_URL=postgres://vercio:vercio@localhost:9002/vercio
VERCIO_SECRET_KEY=change-me-with-at-least-32-random-characters
PUBLIC_URL=http://localhost:9001
# Code de la page de premier lancement (création du compte administrateur)
VERCIO_SETUP_CODE=vercio-dev-setup
LOG_PRETTY=true
# Dossier des environnements déployés (fichiers Compose générés), relatif à apps/server
VERCIO_DATA_DIR=./data
# Socket Docker : détecté automatiquement (Linux, Docker Desktop, Colima…)
# DOCKER_SOCKET=/Users/vous/.docker/run/docker.sock

# SSO Keycloak / OIDC (facultatif) : sans ces lignes, connexion par comptes locaux uniquement.
#
# Votre Keycloak : créez le client « vercio » comme indiqué dans le README, avec
#   Valid redirect URIs : http://localhost:9001/api/auth/oidc/callback
#   Valid post logout redirect URIs : http://localhost:9001/connexion
# OIDC_ISSUER=https://keycloak.example.com/realms/mon-realm
# OIDC_CLIENT_ID=vercio
# OIDC_CLIENT_SECRET=
