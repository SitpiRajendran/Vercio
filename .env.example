# URL publique de Vercio (derrière votre reverse proxy)
PUBLIC_URL=https://vercio.example.com
# Clé de chiffrement des secrets (≥ 32 caractères). Ne la perdez pas : sans elle,
# les tokens et variables secrètes enregistrés deviennent illisibles.
VERCIO_SECRET_KEY=
DB_PASSWORD=
# Code demandé sur la page de premier lancement, pour créer le compte administrateur.
# Vide : un code est affiché dans le journal (docker compose logs vercio).
VERCIO_SETUP_CODE=
# Installation sans interface : crée directement l'administrateur au premier démarrage
# (mot de passe temporaire, à remplacer à la première connexion).
# VERCIO_ADMIN_USERNAME=admin
# VERCIO_ADMIN_PASSWORD=

# Fuseau horaire des sauvegardes planifiées (Europe/Paris par défaut)
TZ=Europe/Paris

# SSO Keycloak (facultatif) : voir le README
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Nombre de reverse proxys devant Vercio (1 par défaut) : sert à lire l'adresse réelle
# des appels de webhooks dans X-Forwarded-For. Accepte aussi une liste d'IP / CIDR.
# TRUST_PROXY=1
